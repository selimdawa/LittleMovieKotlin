<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="all">

    <!-- Internet Access -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Legacy Storage (Required for Android 9 and below) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Modern Granular Storage (Required for Android 13+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".Application"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_icon"
        android:supportsRtl="false"
        android:theme="@style/Theme.MC.S1"
        android:usesCleartextTraffic="true"
        tools:replace="android:supportsRtl">
        <activity
            android:name=".ui.main.SplashActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.cast.CastActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.cast.CastAddActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.editorschoice.EditorsChoiceActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.privacypolicy.PrivacyPolicyEditActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.ForgetPasswordActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.profile.ProfileEditActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.slider.SliderShowActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.privacypolicy.PrivacyPolicyActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.users.UsersActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.category.CategoriesActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.category.CategoryAddActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.category.CategoryEditActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.cast.CastDetailsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.category.CategoryDetailsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.cast.CastEditActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.movie.MovieEditActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.movie.MoviesActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.favorite.FavoritesActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.movie.MovieAddActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.movie.MovieDetailsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.editorschoice.EditorsChoiceAddActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.movie.MovieViewActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.movie.CastMovieAddActivity"
            android:screenOrientation="portrait" />

        <service android:name=".service.FloatingWidgetService" />

        <activity
            android:name=".utils.CropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?mc_bg"
    tools:ignore="all">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profile"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:background="@color/white"
                android:contentDescription="@null"
                android:padding="5dp"
                android:scaleType="centerCrop"
                android:src="@color/image_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                app:strokeColor="@color/white"
                app:strokeWidth="5sp" />

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10sp"
                android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                app:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center"
        android:layout_marginVertical="20sp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_marginHorizontal="10sp"
                android:background="@drawable/round"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_cast"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/numbercast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/zero"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_marginHorizontal="10sp"
                android:background="@drawable/round"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_category_gray"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/numberCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/zero"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="30sp"
                android:layout_height="30sp"
                android:layout_marginHorizontal="10sp"
                android:background="@drawable/round"
                android:backgroundTint="@color/white"
                android:src="@drawable/ic_star_selected"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/numberFavorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/zero"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/edit"
        android:layout_width="40sp"
        android:layout_height="40sp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_margin="20sp"
        android:background="@drawable/round"
        android:backgroundTint="@color/white"
        android:importantForAccessibility="no"
        android:padding="10sp"
        android:src="@drawable/ic_edit_white"
        app:tint="@color/black" />

    <Button
        android:id="@+id/back"
        android:layout_width="35sp"
        android:layout_height="35sp"
        android:layout_alignTop="@id/edit"
        android:layout_alignBottom="@id/edit"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20sp"
        android:background="@drawable/ic_back_white"
        android:gravity="center"
        android:rotation="180"
        app:tint="@color/white" />

</RelativeLayout>
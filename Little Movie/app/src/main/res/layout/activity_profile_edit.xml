<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?mc_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.profile.ProfileEditActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_color" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/image"
                android:layout_width="290sp"
                android:layout_height="290sp"
                android:layout_gravity="center"
                android:layout_marginVertical="20sp"
                android:layout_marginEnd="-10dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:background="@color/white"
                    app:cardCornerRadius="15dp"
                    app:strokeWidth="0dp">

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="15dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/image_profile"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <TextView
                android:id="@+id/usernameLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30sp"
                android:layout_marginTop="10sp"
                android:layout_marginEnd="30sp"
                android:drawablePadding="5sp"
                android:labelFor="@id/nameEt"
                android:text="@string/username"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_person_white"
                app:drawableTint="@color/white" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nameTil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30sp"
                android:layout_marginTop="10sp"
                android:layout_marginEnd="30sp"
                app:hintEnabled="false">

                <EditText
                    android:id="@+id/nameEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:background="@drawable/button4"
                    android:inputType="textPersonName|textCapWords"
                    android:padding="15sp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/go"
                android:layout_width="60sp"
                android:layout_height="60sp"
                android:layout_gravity="center"
                android:layout_margin="50sp"
                android:background="@drawable/button2"
                android:backgroundTint="@color/white"
                android:importantForAccessibility="no"
                android:rotation="180"
                android:src="@drawable/ic_back_white"
                app:tint="@color/dark" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>